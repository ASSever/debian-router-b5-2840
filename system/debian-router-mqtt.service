[Unit]
Description=Debian Router MQTT Status Publisher
After=network.target
ConditionPathExists=/etc/debian-router-b5-2840/mqtt.json

[Service]
Type=simple
ExecStart=@RELEASE@/router-mqtt
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5s
TimeoutStopSec=10s
DynamicUser=yes
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
