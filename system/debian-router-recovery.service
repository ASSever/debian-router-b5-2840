[Unit]
Description=Debian Router Proxy Recovery
After=network.target debian-router-sing-box.service
ConditionPathExists=/etc/debian-router-b5-2840/recovery.json

[Service]
Type=exec
ExecStartPre=@RELEASE@/router-recovery check-config
ExecStart=@RELEASE@/router-recovery
Restart=on-failure
RestartSec=5s
TimeoutStopSec=12s
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/debian-router-agent/proxy-routing /run/lock/debian-router-install.lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
